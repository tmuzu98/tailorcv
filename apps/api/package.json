{
  "name": "@tailorcv/api",
  "version": "0.1.0",
  "private": true,
  "description": "TailorCV backend: Express 5 API.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@tailorcv/shared": "*",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
