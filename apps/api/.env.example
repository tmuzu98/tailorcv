# Copy to apps/api/.env and fill in. Never commit .env.
# All variables are validated at startup in src/config/env.ts.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Frontend origin(s) allowed to call the API. Comma-separated exact URLs, no wildcards.
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops to trust for the client IP: 0 locally, 1 on Render.
# Never set it above 0 without a real proxy in front: clients could fake X-Forwarded-For to dodge rate limits.
TRUST_PROXY=0

# Per-IP rate limits (requests per hour)
RATE_LIMIT_PARSE_PER_HOUR=10
RATE_LIMIT_TAILOR_PER_HOUR=20

# ── LLM provider switch ── change this one line and restart (D-68) ──
#   ollama    → local model via Ollama: free, private, weaker. Development only (default outside production).
#   anthropic → Claude. Required in production (production refuses ollama).
# Check whichever is selected: npm run llm:smoke -w @tailorcv/api
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama). Install: https://ollama.com, then `ollama pull llama3`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Local models are slow: per-request timeout in ms (default 300000 = 5 min)
OLLAMA_TIMEOUT_MS=300000
# Context window in tokens (default 8192). Raise it for very long resumes if your model supports it.
OLLAMA_NUM_CTX=8192

# Overall budget per AI call incl. all retries, in ms (D-72). Default: 120000 for anthropic, 300000 for ollama.
# LLM_DEADLINE_MS=120000

# Claude API (used when LLM_PROVIDER=anthropic). Required in production; optional in development.
# Get a key in the Anthropic Console, and set a monthly spend limit there.
# Check it works: npm run llm:smoke -w @tailorcv/api
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Per-request timeout for Claude calls in ms (default 90000)
LLM_TIMEOUT_MS=90000
