# Copy to apps/api/.env and fill in. Never commit .env.
# All variables are validated at startup in src/config/env.ts.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Frontend origin(s) allowed to call the API. Comma-separated exact URLs, no wildcards.
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops to trust for the client IP: 0 locally, 1 on Render.
# Never set it above 0 without a real proxy in front: clients could fake X-Forwarded-For to dodge rate limits.
TRUST_PROXY=0

# Per-IP rate limits (requests per hour)
RATE_LIMIT_PARSE_PER_HOUR=10
RATE_LIMIT_TAILOR_PER_HOUR=20

# Claude API (required from Day 7). Get a key in the Anthropic Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
