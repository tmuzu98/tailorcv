# Copy to apps/api/.env and fill in. Never commit .env.
# All variables are validated at startup in src/config/env.ts.

# development | test | production
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Frontend origin allowed to call the API (used from Day 5)
CORS_ORIGIN=http://localhost:5173

# Claude API (required from Day 7). Get a key in the Anthropic Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
